# Copy to .env in repository root. Never use NEXT_PUBLIC_ for secrets.
SAMPLE_MODE=true
API_ORIGIN=http://127.0.0.1:8000
MAX_UPLOAD_BYTES=10485760
MAX_UNCOMPRESSED_BYTES=33554432
MAX_ZIP_ENTRIES=500
MAX_XML_BYTES=1048576
MAX_XML_DEPTH=64
MAX_XML_NODES=10000
MAX_XML_TEXT=524288
MAX_RUN_SECONDS=300
# Connected smoke commands require SAMPLE_MODE=false, and explicit configuration.
NIGHTSHIFT_BASE_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
# Routing ID from actual GET /v1/models, not an asserted serving model.
NIGHTSHIFT_ROUTE=
ZETARIS_SQL_ENDPOINT=
# Deployment-specific HTTP query contract; see docs/INTEGRATIONS.md.
ZETARIS_HEADERS_JSON=
ZETARIS_QUERY_FIELD=
# Extra request fields required by the actual endpoint, e.g. {"pageLimit":3}.
ZETARIS_QUERY_OPTIONS_JSON={}
ZETARIS_ROWS_POINTER=
ZETARIS_DEVICE_TABLE=
ZETARIS_SERVER_TABLE=
ZETARIS_SOURCE_PREFIX=
# Legacy alias retained for existing S3 setups; local NDP sources use SOURCE_PREFIX.
ZETARIS_S3_PREFIX=
ZETARIS_DEPLOYMENT_VERSION=
ODK_BASE_URL=
ODK_EMAIL=
ODK_PASSWORD=
ODK_PROJECT_ID=
ODK_FORM_ID=
ODK_SUBMISSION_ID=
ODK_VERSION_ID=
ODK_ATTACHMENT_NAME=
ODK_TEST_PROJECT=false
ODK_CENTRAL_VERSION=
# Stage 4 dedicated synthetic recovery target, separate from Stage 1 read checks.
ODK_RECOVERY_PROJECT_ID=
ODK_RECOVERY_FORM_ID=
ODK_RECOVERY_PROJECT_NAME=LastCopy synthetic Stage 4 recovery
ODK_CONNECTION_ID=local-central-test
ODK_MAPPING_REFERENCE=configured-synthetic-test-project

# Stage 2 local evidence ledger; server-side operator setting only.
# Defaults to private/stage2 when omitted. Never accept this path from API clients.
LASTCOPY_DATA_DIR=private/stage2
# May lower these hard bounds; larger values are rejected.
MAX_RUN_UNCOMPRESSED_BYTES=67108864
MAX_RUN_RECEIPTS=20000
