[Unit]
Description=LastCopy encrypted evidence and Central database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /srv/lastcopy/source/deploy/aws/backup-databases.sh
TimeoutStartSec=360
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/lastcopy/backups /srv/lastcopy/private/application/operations
