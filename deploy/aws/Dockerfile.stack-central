ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY central-dependencies.json /tmp/central-dependencies.json
RUN node --input-type=commonjs -e "const f=require('node:fs'),c=require('node:crypto'),p=JSON.parse(f.readFileSync('/tmp/central-dependencies.json'));const hash=s=>c.createHash('sha256').update(s).digest('hex');const s=f.readFileSync('package-lock.json'),m=f.readFileSync('package.json');if(hash(s)!==p.source_sha256||hash(m)!==p.manifest_source_sha256)throw Error('Unknown Central source');const lock=JSON.parse(s),manifest=JSON.parse(m);manifest.dependencies.nodemailer='10.2.1';manifest.dependencies['csv-parse']='7.0.3';manifest.overrides={hyperid:{uuid:'11.1.1'}};for(const [k,v] of Object.entries(p.packages))lock.packages[k]=v;for(const k of p.removed)delete lock.packages[k];for(const [k,v] of Object.entries(p.legacy))lock.dependencies[k]=v;const out=JSON.stringify(lock,null,2)+'\n',mo=JSON.stringify(manifest,null,2)+'\n';if(hash(out)!==p.output_sha256||hash(mo)!==p.manifest_output_sha256)throw Error('Dependency patch integrity mismatch');f.writeFileSync('package-lock.json',out);f.writeFileSync('package.json',mo)" \
 && npm ci --omit=dev --no-audit --no-fund
